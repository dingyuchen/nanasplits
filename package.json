{
	"name": "nanasplits",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --port 3000",
		"build": "NODE_ENV=production bun --no-env-file --bun vite build --mode production",
		"build:dev": "NODE_ENV=production bun --no-env-file --bun vite build --mode dev",
		"build:binary": "bun --no-env-file --bun scripts/generate-embedded-client-manifest.ts && bun --no-env-file build --compile --minify --sourcemap --bytecode --format=esm --asset-naming='[dir]/[name].[ext]' --define process.env.NODE_ENV='\"production\"' server.ts dist/server/server.js .deploy/embedded-client-assets.ts --outfile dist/nanasplits",
		"deploy:local": "bun --bun scripts/local-deploy.ts",
		"touch": "sh -c 'sleep 1 && touch \"${DEPLOY_ROOT:-/home/hermes/nanasplits}/$1\"' --",
		"start": "bun --bun server.ts",
		"preview": "bun --bun vite preview",
		"lint": "oxlint",
		"format": "oxfmt",
		"check": "bun run lint && oxfmt --check",
		"convex:dev": "convex dev",
		"convex:deploy": "convex deploy",
		"set:webhook": "bun --bun scripts/setup-telegram-webhook.ts",
		"restart:prod": "sudo systemctl restart nanasplits-master@3001.service nanasplits-master@3002.service nanasplits-master@3003.service",
		"restart:dev": "sudo systemctl restart nanasplits-dev.service"
	},
	"dependencies": {
		"@convex-dev/auth": "^0.0.92",
		"@convex-dev/react-query": "^0.1.0",
		"@t3-oss/env-core": "^0.13.11",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.101.0",
		"@tanstack/react-router": "^1.170.15",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.25",
		"@tma.js/init-data-node": "^2.0.7",
		"@tma.js/sdk": "^3.2.2",
		"clsx": "^2.1.1",
		"convex": "^1.41.0",
		"convex-helpers": "^0.1.119",
		"gramio": "^0.10.0",
		"lucide-react": "^1.17.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "^0.7.0",
		"@testing-library/dom": "^10.4.1",
		"@types/babel__core": "^7.20.5",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^29.1.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.69.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"overrides": {
		"@tanstack/router-core": "1.171.13"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	}
}
