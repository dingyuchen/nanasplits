[Unit]
Description=NanaSplits preview instance on port 3000
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/nanasplits
EnvironmentFile=/home/hermes/nanasplits/dev.env
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/home/hermes/nanasplits/dev
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
