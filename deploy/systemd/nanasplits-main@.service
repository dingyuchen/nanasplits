[Unit]
Description=NanaSplits production instance on port %i
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/nanasplits
EnvironmentFile=/home/hermes/nanasplits/main.env
Environment=HOST=127.0.0.1
Environment=PORT=%i
ExecStart=/home/hermes/nanasplits/main
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
